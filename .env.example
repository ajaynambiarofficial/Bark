NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://bark:bark@localhost:5432/bark
APP_ORIGIN=http://localhost:5173
# Optional Google Identity Services web client ID. Set the same value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Used by Team Email's Gmail API sender. The OAuth redirect URI is
# {APP_ORIGIN}/api/team-emails/google/callback.
GOOGLE_CLIENT_SECRET=
MAIL_TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=bark_session
SESSION_TTL_HOURS=12
TRUST_PROXY=false
LOG_LEVEL=info

# Optional escalation email delivery. For Google Workspace/Gmail use smtp.gmail.com,
# port 465, secure=true, and an account-specific App Password (never your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@example.supertails.com
SMTP_PASSWORD=replace-with-mail-app-password
EMAIL_FROM=notifications@example.supertails.com

# Used only by `npm run db:seed`; use a unique password of at least 14 characters.
GOD_EMAIL=admin@example.supertails.com
GOD_PASSWORD=replace-with-a-long-unique-development-password
